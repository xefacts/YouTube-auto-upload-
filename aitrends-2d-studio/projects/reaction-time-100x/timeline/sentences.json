[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.96,
  "text": "A fly buzzes past your ear."
 },
 {
  "i": 1,
  "start": 2.29,
  "end": 3.04,
  "text": "You don't look."
 },
 {
  "i": 2,
  "start": 3.34,
  "end": 3.76,
  "text": "You just..."
 },
 {
  "i": 3,
  "start": 3.96,
  "end": 4.48,
  "text": "know."
 },
 {
  "i": 4,
  "start": 5.05,
  "end": 10.34,
  "text": "Leo fumbles his phone over the sink, and before it has dropped ten centimeters, your hand is already there."
 },
 {
  "i": 5,
  "start": 10.88,
  "end": 12.37,
  "text": "Then the soccer ball leaves his foot."
 },
 {
  "i": 6,
  "start": 12.83,
  "end": 13.44,
  "text": "You watch it..."
 },
 {
  "i": 7,
  "start": 13.72,
  "end": 14.48,
  "text": "all the way."
 },
 {
  "i": 8,
  "start": 14.92,
  "end": 16.32,
  "text": "Like it's swimming through honey."
 },
 {
  "i": 9,
  "start": 16.8,
  "end": 18.31,
  "text": "And your tea, sitting on the counter?"
 },
 {
  "i": 10,
  "start": 18.71,
  "end": 19.29,
  "text": "Still hot."
 },
 {
  "i": 11,
  "start": 19.92,
  "end": 22.21,
  "text": "Most people react in about a quarter of a second."
 },
 {
  "i": 12,
  "start": 22.54,
  "end": 24.4,
  "text": "Two hundred and fifty milliseconds."
 },
 {
  "i": 13,
  "start": 24.75,
  "end": 26.34,
  "text": "Eye, to brain, to hand."
 },
 {
  "i": 14,
  "start": 26.81,
  "end": 27.1,
  "text": "You?"
 },
 {
  "i": 15,
  "start": 27.57,
  "end": 29.04,
  "text": "Two and a half milliseconds."
 },
 {
  "i": 16,
  "start": 29.61,
  "end": 31.46,
  "text": "Here's the rule that runs the whole story."
 },
 {
  "i": 17,
  "start": 31.89,
  "end": 33.23,
  "text": "Your brain got faster."
 },
 {
  "i": 18,
  "start": 33.54,
  "end": 34.35,
  "text": "Nothing else did."
 },
 {
  "i": 19,
  "start": 34.79,
  "end": 36.92,
  "text": "Muscles can't move quicker than muscle moves."
 },
 {
  "i": 20,
  "start": 37.29,
  "end": 38.56,
  "text": "The world didn't slow down."
 },
 {
  "i": 21,
  "start": 38.89,
  "end": 39.44,
  "text": "You just..."
 },
 {
  "i": 22,
  "start": 39.45,
  "end": 40.33,
  "text": "started earlier."
 },
 {
  "i": 23,
  "start": 40.89,
  "end": 43.48,
  "text": "So what if your reaction time was a hundred times faster?"
 },
 {
  "i": 24,
  "start": 43.93,
  "end": 45.96,
  "text": "Plus: you never drop anything."
 },
 {
  "i": 25,
  "start": 46.27,
  "end": 46.66,
  "text": "Ever."
 },
 {
  "i": 26,
  "start": 47.02,
  "end": 47.99,
  "text": "Falling keys."
 },
 {
  "i": 27,
  "start": 48.0,
  "end": 49.01,
  "text": "Falling eggs."
 },
 {
  "i": 28,
  "start": 49.02,
  "end": 49.95,
  "text": "Falling grandma."
 },
 {
  "i": 29,
  "start": 50.28,
  "end": 53.03,
  "text": "Plus: video games become ridiculous."
 },
 {
  "i": 30,
  "start": 53.43,
  "end": 55.67,
  "text": "A screen refreshes sixty times a second."
 },
 {
  "i": 31,
  "start": 55.97,
  "end": 58.84,
  "text": "You see things seventeen times before anyone else does."
 },
 {
  "i": 32,
  "start": 59.34,
  "end": 60.63,
  "text": "Leo spins the controller."
 },
 {
  "i": 33,
  "start": 61.07,
  "end": 61.61,
  "text": "\"Mate."
 },
 {
  "i": 34,
  "start": 61.62,
  "end": 63.39,
  "text": "You really have to stop doing that.\""
 },
 {
  "i": 35,
  "start": 63.92,
  "end": 66.34,
  "text": "Minus: everything else is slow."
 },
 {
  "i": 36,
  "start": 66.76,
  "end": 68.48,
  "text": "A sentence takes a whole second..."
 },
 {
  "i": 37,
  "start": 68.7,
  "end": 70.55,
  "text": "and you've already written four replies."
 },
 {
  "i": 38,
  "start": 70.97,
  "end": 72.99,
  "text": "And at night, you can't switch it off."
 },
 {
  "i": 39,
  "start": 73.49,
  "end": 74.32,
  "text": "You lie there..."
 },
 {
  "i": 40,
  "start": 74.6,
  "end": 75.21,
  "text": "and count."
 },
 {
  "i": 41,
  "start": 75.76,
  "end": 79.42,
  "text": "Minus: your brain is now the most expensive organ you own."
 },
 {
  "i": 42,
  "start": 79.91,
  "end": 82.5,
  "text": "It already burns about twenty percent of your daily energy."
 },
 {
  "i": 43,
  "start": 82.9,
  "end": 84.22,
  "text": "Speed costs fuel."
 },
 {
  "i": 44,
  "start": 84.58,
  "end": 85.53,
  "text": "Your breakfast..."
 },
 {
  "i": 45,
  "start": 85.54,
  "end": 86.35,
  "text": "never ends."
 },
 {
  "i": 46,
  "start": 86.72,
  "end": 88.48,
  "text": "And your brain is built on surprise."
 },
 {
  "i": 47,
  "start": 88.86,
  "end": 89.78,
  "text": "Predict everything..."
 },
 {
  "i": 48,
  "start": 90.02,
  "end": 91.63,
  "text": "and nothing surprises you anymore."
 },
 {
  "i": 49,
  "start": 92.17,
  "end": 93.12,
  "text": "Leo tells a joke."
 },
 {
  "i": 50,
  "start": 93.4,
  "end": 95.42,
  "text": "You already saw the punchline in his shoulder."
 },
 {
  "i": 51,
  "start": 95.74,
  "end": 96.45,
  "text": "So you laugh..."
 },
 {
  "i": 52,
  "start": 96.69,
  "end": 97.47,
  "text": "a second late."
 },
 {
  "i": 53,
  "start": 97.86,
  "end": 98.58,
  "text": "On purpose."
 },
 {
  "i": 54,
  "start": 99.12,
  "end": 99.85,
  "text": "Sad, isn't it?"
 },
 {
  "i": 55,
  "start": 100.4,
  "end": 101.26,
  "text": "Then there's Mia."
 },
 {
  "i": 56,
  "start": 101.5,
  "end": 102.27,
  "text": "Your little sister."
 },
 {
  "i": 57,
  "start": 102.63,
  "end": 103.23,
  "text": "She's nine."
 },
 {
  "i": 58,
  "start": 103.52,
  "end": 105.76,
  "text": "And she's the only person who can slow you down."
 },
 {
  "i": 59,
  "start": 106.26,
  "end": 107.97,
  "text": "Every night she needs the same thing."
 },
 {
  "i": 60,
  "start": 108.33,
  "end": 109.76,
  "text": "Two knocks on the frame of her door."
 },
 {
  "i": 61,
  "start": 110.1,
  "end": 110.64,
  "text": "Then one."
 },
 {
  "i": 62,
  "start": 111.04,
  "end": 111.68,
  "text": "That's the deal."
 },
 {
  "i": 63,
  "start": 112.01,
  "end": 112.89,
  "text": "That's the language."
 },
 {
  "i": 64,
  "start": 113.29,
  "end": 114.44,
  "text": "Then comes the museum."
 },
 {
  "i": 65,
  "start": 114.83,
  "end": 115.62,
  "text": "A lamp goes out."
 },
 {
  "i": 66,
  "start": 115.91,
  "end": 117.81,
  "text": "Emergency lights, red and thin."
 },
 {
  "i": 67,
  "start": 118.16,
  "end": 120.44,
  "text": "Mia is across the hall, near the dark stairs."
 },
 {
  "i": 68,
  "start": 120.81,
  "end": 124.13,
  "text": "A forty kilo barrier is sliding toward a group of smaller kids."
 },
 {
  "i": 69,
  "start": 124.49,
  "end": 126.31,
  "text": "A screen falls from three meters."
 },
 {
  "i": 70,
  "start": 126.65,
  "end": 127.79,
  "text": "Eight tenths of a second."
 },
 {
  "i": 71,
  "start": 128.14,
  "end": 129.55,
  "text": "You cannot run faster."
 },
 {
  "i": 72,
  "start": 129.76,
  "end": 131.28,
  "text": "You can only start earlier."
 },
 {
  "i": 73,
  "start": 131.69,
  "end": 133.09,
  "text": "You shout it on the metal rail."
 },
 {
  "i": 74,
  "start": 133.37,
  "end": 134.01,
  "text": "Two knocks."
 },
 {
  "i": 75,
  "start": 134.19,
  "end": 134.75,
  "text": "Then one."
 },
 {
  "i": 76,
  "start": 135.12,
  "end": 136.04,
  "text": "Mia freezes."
 },
 {
  "i": 77,
  "start": 136.3,
  "end": 137.42,
  "text": "She knows that knock."
 },
 {
  "i": 78,
  "start": 137.79,
  "end": 140.19,
  "text": "You lean into the barrier before it is really moving..."
 },
 {
  "i": 79,
  "start": 140.44,
  "end": 141.67,
  "text": "and the lean wins."
 },
 {
  "i": 80,
  "start": 141.98,
  "end": 144.11,
  "text": "The screen lands on an empty patch of floor."
 },
 {
  "i": 81,
  "start": 144.51,
  "end": 145.6,
  "text": "Your sister's hand..."
 },
 {
  "i": 82,
  "start": 145.85,
  "end": 146.7,
  "text": "is in yours."
 },
 {
  "i": 83,
  "start": 147.19,
  "end": 148.88,
  "text": "That night, she knocks twice."
 },
 {
  "i": 84,
  "start": 149.12,
  "end": 149.79,
  "text": "Then once."
 },
 {
  "i": 85,
  "start": 150.14,
  "end": 150.77,
  "text": "You answer..."
 },
 {
  "i": 86,
  "start": 151.01,
  "end": 151.83,
  "text": "at normal speed."
 },
 {
  "i": 87,
  "start": 152.23,
  "end": 153.6,
  "text": "The gift didn't disappear."
 },
 {
  "i": 88,
  "start": 153.91,
  "end": 155.71,
  "text": "It just stopped mattering as much."
 },
 {
  "i": 89,
  "start": 155.9,
  "end": 157.82,
  "text": "You've started letting the tea go cold..."
 },
 {
  "i": 90,
  "start": 158.28,
  "end": 159.11,
  "text": "on purpose."
 },
 {
  "i": 91,
  "start": 159.69,
  "end": 162.95,
  "text": "Tell us in the comments which everyday thing you would save first."
 },
 {
  "i": 92,
  "start": 163.3,
  "end": 164.99,
  "text": "And if you felt that second knock..."
 },
 {
  "i": 93,
  "start": 165.28,
  "end": 167.76,
  "text": "hit like, and subscribe for more What Ifs."
 }
]